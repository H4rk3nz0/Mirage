# Self-driving Proteus cover recorder - keeps a PINNED replay library fresh.
#
# You probably do not need this. `proteus: true` makes the daemon source and
# refresh its own library in-process; this unit is only for an operator who has
# pinned `proteus_profile` to a specific library (which turns auto-sourcing off)
# and still wants it topped up.
#
# Install: edit the paths/User below, then
#   sudo cp mirage-cover-recorder.service /etc/systemd/system/
#   sudo systemctl enable --now mirage-cover-recorder
# Point the bridge/client at the class dir it fills:
#   proteus: "replay", proteus_profile: "/opt/mirage/library/video"
# For a browse-class library too, run a second copy with `--mode browse`.
# Self-contained: mirage-cover-record needs no external tools or extra capabilities.
[Unit]
Description=Proteus cover-source recorder (refreshes the real-traffic replay library)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirage
WorkingDirectory=/opt/mirage
# Every 30 min: record 2 fresh random traces, keep the newest 40.
ExecStart=/usr/local/bin/mirage-cover-record /opt/mirage/library --loop 30 --count 2 --max 40
Restart=on-failure
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
